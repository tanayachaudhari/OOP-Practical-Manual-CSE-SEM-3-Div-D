#include <iostream>
#include <stack>
#include <string>
using namespace std;

//Generic Stack Class
template <class T>
class GenericStack
{
private :
stack<T>  s;

public :
void push(const T& value)
{
s.push(value);
}
bool pop(T& value)
{
if(s.empty())
return false;

value = s.top( ) ;
s.pop( );
return true;
}
bool peek(T& value) const
{
if (s.empty())

return false;
value = s.top( );
return true;
}

bool isEmpty( ) const
{
return s.empty( );
}
};

