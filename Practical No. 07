#include <iostream>
using namespace std;

//Function Overloading
int add(int a, int b)
{
return a + b;
}
//Complex Number Class
class ComplexNumber
{
private:
double real, imag;

public:
ComplexNumber(double r, double i)
{
real = r;
imag = i;
}
//Operator Overloading
ComplexNumber operator+(const ComplexNumber & c) const


{
return ComplexNumber(real + c.real, imag + c.imag);
}

void display( ) const
{
cout  <<  real;

if (imag  >=  0)
cout << " + " << imag <<  "i";
else
cout  << " - " << -imag << "i";
}
};

