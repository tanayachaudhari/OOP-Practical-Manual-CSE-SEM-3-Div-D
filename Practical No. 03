#include <iostream>
#include <initializer_list>
#include <utility>
using namespace std;

class DynamicArray
{
private :
int* arr;
int size;

public :
// 1. Default Constructor
DynamicArray( )
{
arr = nullptr;
size = 0;
}

//2. Parameterized Constructor
DynamicArray(initializer_list<int>  values)
{
size = values.size( ) ;
arr = size > 0 ? new int[size] : nullptr;

int i = 0;
for (int value : values)

{
arr[i++] = value;
    }
}

//3. Copy Constructor – Deep Copy
DynamicArray(const DynamicArray & other)
{
size = other.size;

arr = size > 0 ? new int[size] : nullptr;

for (int i = 0; i < size; i++)
{
arr[i] = other.arr[i];
}
}

//4. Copy Assignment Operator – Deep Copy
DynamicArray & operator = (const DynamicArray & other)
{
if (this  !=  &other)
{
int* newArr = other.size > 0
? new int[other.size] :  nullptr;

for (int i  = 0; i < other.size; i++)
{
newArr[i] = other.arr[i];
}
delete[] arr;

arr = newArr;
size = other.size;
}
return *this;
}

//5. Move Constructor – Transfers Ownership
DynamicArray(DynamicArray && other) noexcept
{

arr = other.arr;
size = other.size;

other.arr = nullptr;
other.size = 0;
}

//6. Move Assignment Operator
DynamicArray & operator = (DynamicArray && other) noexcept
{

if (this != &other)
{
delete[] arr;

arr = other.arr;
size = other.size;

other.arr = nullptr;
other.size = 0;
}
return *this;
}

//Destructor – Releases Allocated Memory
~DynamicArray( )
{
delete[] arr;
}

//Display Array Elements
void display( ) const
{
if (size == 0)

{
cout << "Array is empty. " << endl;
return;
}

for (int i = 0; i < size; i++)
{
cout << arr[i] << " ";
}
cout << endl;
}

//Modify an Array Element
void setValue(int index, int value)
{
if ( index >= 0 && index < size)
{
arr[index] = value;
     }
  }
};

