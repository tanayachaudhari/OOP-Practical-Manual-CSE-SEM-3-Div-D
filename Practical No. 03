source.display( );

//Move Assignment Operator
cout << "\n6. Move Assignment Operator : " << endl;
DynamicArray moveSource{70, 80, 90};
DynamicArray moveAssigned{1, 2};

moveAssigned = move(moveSource);

cout << "Move Assignment Array : ";
moveAssigned.display( );

cout << "Source Array after move : ";
