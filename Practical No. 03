//Default Constructor
cout << "1. Default Constructor: " << endl;
DynamicArray a;
a.display();

//Parameterized Constructor
cout << "\n2. Parameterizes Constructor : " << endl;
DynamicArray original {10, 20, 30};
original.display();

//Copy Constructor
cout << "\n3. Copy Constructor : " <<endl;
DynamicArray copied(original);
copied.display( );

//Demonstrating Deep Copy
copied.setValue(0, 100);
cout << "\nAfter modifying copied array : " << endl;

cout << "Original Array : ";
original.display();
cout << "Copied Array : " ;
copied.display();

//Copy Assignment Operator
cout << "\n4. Copy Assignment Operator: " << endl;

DynamicArray copyAssigned{5, 5};
copyAssigned = original;
copyAssigned.display( );

//Move Constructor
cout << "\n5. Move Constructor : " << endl;
DynamicArray source{40, 50, 60};
