#include <iostream>
#include <string>
using namespace std;

//Base class
class Person {
protected:
string name;
int age;

public :
Person(string n, int a) {
name = n;
age = a;
}

void displayPerson( ) {
cout << "Name :  " << name << endl;
cout << "Age : "  << age << endl;
     }
};

//Derived class
class Student : public Person {
protected :
string studentID;

string course;

public :
Student(string n, int a, string id, string c)
: Person(n, a)  {
studentID = id;
course = c;
}

void displayStudent( ) {
displayPerson ( );
cout << "Student ID : " << studentID << endl;
cout << "Course : "  << course << endl;
}
};

//Multilevel derived class
class GraduateStudent : public Student {
private :
string researchTopic;

public : 
GraduateStudent(string n, int a, string id, string c, string topic)
: Student(n, a, id, c) {
researchTopic = topic;
}

void displayGraduateStudent( ) {
displayStudent( );
cout << "Research Topic : " << researchTopic << endl;
}
};

int main( ) {

cout<< "Student Name : TANAYA SANDIP CHAUDHARI" <<endl;
cout<< "Student URN No. : E26B00S3149" << endl;

//Single inheritance
Student s("TANAYA CHAUDHARI", 20, "ADYPU101", "B.TECH CSE");
 
// Multilevel inheritance
GraduateStudent gs("Tanaya Chaudhari", 21, "ADYPU201", "M.TECH CSE",  "Artificial Intelligence ");

cout << " -----Student Details ----- "  << endl;
s.displayStudent( ) ;

cout << "\n -----Graduate Student Details -----" << endl;
gs.displayGraduateStudent( );

return 0;
}
