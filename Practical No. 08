#include <iostream>
using namespace std;

//Base class
class Shape {
public :
virtual void draw( ) = 0;
virtual ~Shape ( ) { }
};

// Derived class
class Circle : public Shape {
public :
void draw( ) override {
cout << " Circle object created. " << endl;
}
};

//Derived class
class Rectangle : public Shape {
public : void draw ( ) override {
cout << "Rectangle object created. " << endl;
}
};

//Factory function
Shape* createShape(int type) {
if (type == 1)
return new Circle( );

else if (type == 2)
return new Rectangle( );
else
return nullptr;
}

