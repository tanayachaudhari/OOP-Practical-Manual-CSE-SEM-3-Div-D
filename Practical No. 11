// Student record
struct Student {
int id;
string name;
double marks;
};

//Function to validate CSV records
bool parseStudent(const string& line, Student& s) {
string idText, name, marksText;
stringstream row(line);

if  (!getline(row, idText, ',')  ||
!getline(row, name, ',')  ||
!getline(row, marksText)  ||
name.empty( )  || marksText.find( ',')  != string::npos)
return false;

stringstream idInput(idText), marksInput(marksText);
char extra;


if  (!  ( idInput >> s.id)  || (idInput >> extra) )
return false;

if  (!  (marksInput  >> s.marks )  || (marksInput >> extra))
return false;

s.name = name;
return true;
}

